rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Connectivity health-check path
    match /test/{docId} {
      allow read, write: if true;
    }

    // Account mappings for phone & email fast lookup
    match /account_mappings/{mappingId} {
      allow read, write: if true;
    }

    // User-scoped workspace for shop profile, memos, parties, rates, settings, and backups
    match /users/{userId} {
      allow read, write: if true;

      match /{subpath=**} {
        allow read, write: if true;
      }
    }
  }
}
